{
  "manifest_version": 3,
  "name": "SoundCloud Like Ratio",
  "version": "1.1.1",
  "description": "Shows SoundCloud like percentages and can filter or sort loaded tracks.",
  "homepage_url": "https://github.com/TomoZG/soundcloud-like-ratio",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://soundcloud.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "soundcloud-like-ratio@tomozg.github.io",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
