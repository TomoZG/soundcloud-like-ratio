{
  "manifest_version": 3,
  "name": "SoundCloud Like Ratio",
  "version": "0.5.1",
  "description": "Shows SoundCloud like percentages and can sort loaded tracks by percentage.",
  "content_scripts": [
    {
      "matches": [
        "https://soundcloud.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
